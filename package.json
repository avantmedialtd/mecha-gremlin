{
    "name": "mecha-gremlin",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "hello": "bun packages/server/src/main.ts",
        "test": "bun test",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint --deny-warnings",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "check": "bun run format:check && bun run lint && bun run typecheck && bun test"
    },
    "devDependencies": {
        "@types/bun": "^1.4.2",
        "oxfmt": "^0.72.0",
        "oxlint": "^1.87.0",
        "typescript": "^7.0.2"
    }
}
