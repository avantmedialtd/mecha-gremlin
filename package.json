{
    "name": "mecha-gremlin",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "agent": "bun packages/agent/src/main/main.ts",
        "agent:node": "node --env-file-if-exists=.env packages/agent/src/main/main.ts",
        "test": "TEST_RUNTIME=bun bunx --bun vitest run",
        "test:watch": "TEST_RUNTIME=bun bunx --bun vitest",
        "test:node": "TEST_RUNTIME=node vitest run",
        "mutation": "TEST_RUNTIME=bun bun --bun --preload ./stryker.preload.ts node_modules/.bin/stryker run",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint --deny-warnings",
        "spellcheck": "cspell --no-progress .",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "check": "bun run format:check && bun run lint && bun run spellcheck && bun run typecheck && bun run test && bun run test:node"
    },
    "devDependencies": {
        "@stryker-mutator/core": "^10.1.1",
        "@stryker-mutator/vitest-runner": "^10.1.1",
        "@types/bun": "^1.4.4",
        "cspell": "^10.4.0",
        "oxfmt": "^0.75.0",
        "oxlint": "^1.90.0",
        "oxlint-tsgolint": "^7.0.2005",
        "typescript": "^7.0.2",
        "vitest": "^5.0.5"
    },
    "overrides": {
        "qs": "^6.17.1"
    }
}
