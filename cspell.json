{
    "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
    "version": "0.2",
    "language": "en,en-GB",
    "useGitignore": true,
    "enableGlobDot": true,
    // OpenSpec generates the command files under .claude/commands and .opencode.
    "ignorePaths": [".git", "bun.lock", ".claude/commands", ".opencode"],
