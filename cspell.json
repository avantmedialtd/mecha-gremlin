{
    "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
    "version": "0.2",
    "language": "en,en-GB",
    "useGitignore": true,
    "enableGlobDot": true,
    // OpenSpec generates the command files under .claude/commands and .opencode.
    "ignorePaths": [".git", "bun.lock", ".claude/commands", ".opencode"],
    // CSpell turns these on only for their own file types, but the docs and config talk about
    // code too.
    "dictionaries": [
        "typescript",
        "node",
        "npm",
        "fullstack",
        "bash",
        "shellscript",
        "python",
        "sql",
        "docker"
    ],
    "words": [
        "aaif",
        "agentskills",
        "Airtable",
        "anomalyco",
        "anthropics",
        "badlogic",
        "BFCL",
        "bunx",
        "codegen",
        "codemod",
        "creds",
        "devday",
        "direnv",
        "dumpable",
        "Elevantiq",
        "envd",
        "envrc",
        "genai",
        "halfvec",
        "healthchecks",
        "HNSW",
        "huggingface",
        "isready",
        "Junie",
        "Kiro",
        "langgraph",
        "libpq",
        "llmster",
        "lmstudio",
        "LOGNAME",
        "logprobs",
        "lossily",
        "Nemotron",
        "nomic",
        "oaiapp",
        "openclaw",
        "opencode",
        "openhands",
        "openresponses",
        "openspec",
        "ornith",
        "pdftotext",
        "pgdata",
        "pgid",
        "pgvector",
        "procps",
        "quickstarts",
        "Qwen",
        "reparented",
        "replayable",
        "runconfig",
        "savepoints",
        "setsid",
        "SHLVL",
        "simonwillison",
        "SIWC",
        "smolagents",
        "Sottiaux",
        "statelessly",
        "Supabase",
        "thsottiaux",
        "Tibo",
        "tsgolint",
        "unmutated",
        "unparseable",
        "unrefs",
        "unstub",
        "upserts",
        "Vendure",
        "Willison",
        "worktrees",
        "xhigh",
        "навык"
    ],
    // Not words: strings in core's output tests, and ps and grep flags.
    "ignoreWords": [
        "auxww",
        "axeww",
        "cdef",
        "defghijk",
        "nfghi",
        "nghij",
        "nhijk",
        "nzzzz",
        "nzzzzz",
        "rnoi",
        "zzzzzyyy"
    ]
}
