{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "vitest"],
    "categories": {
        "correctness": "error",
        "suspicious": "warn"
    },
    "options": {
        "typeAware": true
    },
    "rules": {
        "curly": ["error", "all"],
        "prefer-const": "error",
        "prefer-arrow-callback": "error",
        "func-style": ["error", "expression"],
        "no-use-before-define": "error",
        "no-param-reassign": ["error", { "props": true }],
        "typescript/consistent-type-definitions": ["error", "type"],
        "typescript/consistent-return": "off",
        "typescript/prefer-readonly-parameter-types": [
            "error",
            {
                "ignoreInferredTypes": true,
                "treatMethodsAsReadonly": true,
                "allow": [
                    { "from": "lib", "name": ["Uint8Array"] },
                    {
                        "from": "package",
                        "package": "bun-types",
                        "name": ["AbortSignal", "Request", "RequestInit", "URL"]
                    },
                    {
                        "from": "package",
                        "package": "openai",
                        "name": [
                            "OpenAI",
                            "Response",
                            "ResponseFunctionToolCall",
                            "ResponseInputItemLike",
                            "ResponseOutputItem",
                            "ResponseUsage"
                        ]
                    }
                ]
            }
        ]
    },
    "env": {
        "builtin": true
    },
    "overrides": [
        {
            "files": ["packages/core/src/**"],
            "rules": {
                "no-console": "error",
                "no-restricted-globals": [
                    "error",
                    {
                        "name": "process",
                        "message": "core stays free of configuration and side effects: no env, stdout or stderr."
                    },
                    {
                        "name": "Bun",
                        "message": "core stays runtime-neutral: no Bun.env or other Bun APIs."
                    }
                ]
            }
        },
        {
            "files": ["packages/yaml/src/**", "packages/process/src/**"],
            "rules": {
                "no-console": "error",
                "no-restricted-globals": [
                    "error",
                    {
                        "name": "process",
                        "message": "The runtime packages report only through their results, and a spawned process gets only the environment it's given: no env, stdout or stderr."
                    }
                ]
            }
        },
        {
            "files": ["packages/*/test/**"],
            "rules": {
                "typescript/no-unsafe-type-assertion": "off"
            }
        }
    ]
}
