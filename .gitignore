node_modules/
.DS_Store

# Stryker mutation testing: sandboxes and reports.
.stryker-tmp/
reports/

# The scheduler's Rust builds, and cargo-mutants' reports, which would fail oxfmt and CSpell, and
# whose lock.json records the host's name and user.
target/
mutants.out*/

# playwright-cli's workspace and snapshots, for runs whose working directory is the repository.
.playwright/
.playwright-cli/

# Secrets and local settings never go into this public repo.
.env
.env.*
*.env
!*.env.example

# The agent's database holds OAuth tokens, and a data folder may sit inside a checkout.
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal

.claude/worktrees
